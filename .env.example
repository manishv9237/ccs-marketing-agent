# Copy to .env for LOCAL use only. Never commit .env. On a host, set these as SECRETS in its dashboard.

# --- required -------------------------------------------------------------
OPENAI_API_KEY=
# Option A (one shared code, anyone picks a display name):
APP_ACCESS_CODE=choose-a-long-random-code-here

# --- local testing only: skip the login screen (NEVER on a public host) ----
# ALLOW_NO_AUTH=1

# --- models ---------------------------------------------------------------
# ALLOWED_MODELS=gpt-5-nano,gpt-5.4-nano,gpt-6-luna,gpt-5.6-luna
# DEFAULT_MODEL=gpt-5-nano
# EMBEDDER=auto            # auto | fastembed | sentence-transformers | openai | none

# --- web discovery (optional) -------------------------------------------------
# SEARCH_PROVIDER=auto     # auto (DuckDuckGo) | tavily | brave | none
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# --- budget protection (per UTC day) -----------------------------------------
# GEN_PER_USER_DAY=25
# GEN_GLOBAL_DAY=400
# SEARCH_PER_USER_DAY=30
# MAX_BRANDS_PER_USER=5

# --- storage ----------------------------------------------------------------
# DATA_DIR=./data

# --- tuning (optional) ---
VERIFIER_MODEL=gpt-5.4-nano
DEFAULT_TOP_K=6
DEFAULT_HYBRID=0.5

# Option B (individual accounts, same single link): comma-separated username:password pairs.
# Usernames: lowercase letters/digits/._- (2-32 chars). Passwords: 6+ chars, no commas. When set, replaces the shared code.
# APP_USERS=manish:change-me-1,priya:change-me-2,rahul:change-me-3

# Evaluation tab limits (optional). EVAL_USERS = comma list of usernames allowed to run it; empty = everyone.
# EVAL_PER_USER_DAY=100
# EVAL_GLOBAL_DAY=300
# EVAL_USERS=priya
